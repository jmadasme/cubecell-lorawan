[39.305, "o", "\u001b[90m┌─ Buffers, tiempos y payload de heartbeat ─────────────────────────────────────────────────────────────\u001b[0m\n"]
[39.305, "o", "\u001b[90m  63\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine MAX_PAYLOAD     51\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[39.36, "o", "\u001b[90m  64\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine SERIAL_BUF      256\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[39.415, "o", "\u001b[90m  65\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine STALE_MS        500\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[39.47, "o", "\u001b[90m  66\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine HEARTBEAT_MS    30000UL   \u001b[39;49;00m\u001b[90m/* heartbeat cada 30 segundos */\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[39.525, "o", "\u001b[90m  67\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[39.58, "o", "\u001b[90m  68\u001b[0m\u001b[90m │ \u001b[0m\u001b[96muint8_t\u001b[39;49;00m\u001b[90m  \u001b[39;49;00mtxBuffer[MAX_PAYLOAD];\u001b[90m\u001b[39;49;00m\n"]
[39.635, "o", "\u001b[90m  69\u001b[0m\u001b[90m │ \u001b[0m\u001b[96msize_t\u001b[39;49;00m\u001b[90m   \u001b[39;49;00mtxLen\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00m\u001b[94m0\u001b[39;49;00m;\u001b[90m\u001b[39;49;00m\n"]
[39.69, "o", "\u001b[90m  70\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[39.745, "o", "\u001b[90m  71\u001b[0m\u001b[90m │ \u001b[0m\u001b[96mchar\u001b[39;49;00m\u001b[90m     \u001b[39;49;00mserialLine[SERIAL_BUF];\u001b[90m\u001b[39;49;00m\n"]
[39.8, "o", "\u001b[90m  72\u001b[0m\u001b[90m │ \u001b[0m\u001b[96msize_t\u001b[39;49;00m\u001b[90m   \u001b[39;49;00mserialPos\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00m\u001b[94m0\u001b[39;49;00m;\u001b[90m\u001b[39;49;00m\n"]
[39.855, "o", "\u001b[90m  73\u001b[0m\u001b[90m │ \u001b[0m\u001b[96muint32_t\u001b[39;49;00m\u001b[90m \u001b[39;49;00mlastCharMs\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00m\u001b[94m0\u001b[39;49;00m;\u001b[90m\u001b[39;49;00m\n"]
[39.91, "o", "\u001b[90m  74\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[39.965, "o", "\u001b[90m  75\u001b[0m\u001b[90m │ \u001b[0m\u001b[96muint32_t\u001b[39;49;00m\u001b[90m \u001b[39;49;00mlastUplinkMs\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00m\u001b[94m0\u001b[39;49;00m;\u001b[90m        \u001b[39;49;00m\u001b[90m/* timestamp del ultimo uplink */\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[40.02, "o", "\u001b[90m  76\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mconst\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[96muint8_t\u001b[39;49;00m\u001b[90m \u001b[39;49;00mheartbeatPayload[]\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00m{\u001b[90m \u001b[39;49;00m\u001b[94m0xBB\u001b[39;49;00m\u001b[90m \u001b[39;49;00m};\u001b[90m \u001b[39;49;00m\u001b[90m/* marcador de heartbeat */\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[40.075, "o", "\u001b[90m  77\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mconst\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[96msize_t\u001b[39;49;00m\u001b[90m \u001b[39;49;00mheartbeatLen\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00m\u001b[94m1\u001b[39;49;00m;\u001b[90m\u001b[39;49;00m\n"]
